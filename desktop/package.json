{
  "name": "spool-desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc --noEmit && vite build",
    "prepare:desktop": "node scripts/build-backend.mjs",
    "desktop": "tauri",
    "desktop:dev": "pnpm prepare:desktop && tauri dev",
    "desktop:build": "pnpm prepare:desktop && tauri build",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:desktop": "pnpm prepare:desktop && node --test backend/*.test.mjs",
    "verify:publication": "node scripts/verify-publication.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@floating-ui/react-dom": "2.1.6",
    "@github/copilot-sdk": "1.0.16",
    "@lexical/code-core": "0.51.0",
    "@lexical/code-prism": "0.51.0",
    "@lexical/extension": "0.51.0",
    "@lexical/history": "0.51.0",
    "@lexical/link": "0.51.0",
    "@lexical/list": "0.51.0",
    "@lexical/markdown": "0.51.0",
    "@lexical/react": "0.51.0",
    "@lexical/rich-text": "0.51.0",
    "@lexical/selection": "0.51.0",
    "@lexical/table": "0.51.0",
    "@lexical/utils": "0.51.0",
    "@spool/workflow": "file:../packages/workflow",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.13",
    "@xyflow/react": "12.12.0",
    "lexical": "0.51.0",
    "lucide-react": "1.47.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "recharts": "3.10.1",
    "streamdown": "2.6.0",
    "use-stick-to-bottom": "1.1.6"
  },
  "dependenciesMeta": {
    "@spool/workflow": {
      "injected": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@lexical/headless": "0.51.0",
    "@playwright/test": "1.63.0",
    "@storybook/react-vite": "10.6.0",
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "@types/node": "^25.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "storybook": "10.6.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
