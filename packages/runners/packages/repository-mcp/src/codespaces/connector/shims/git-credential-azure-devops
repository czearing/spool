#!/usr/bin/env bash
# Shared git credential helper (consumer side of the unified shim).
# Adapted verbatim from packages/sandbox/git-credential-azure-devops so the SAME
# helper serves both sandboxes and codespaces. Fetches a fresh ADO token from
# the broker's Unix socket per git request.
#
# Wiring (identical to packages/sandbox/src/sandbox.ts:976):
#   git config credential.helper "!bash <this> <socket-path>"
#   git config credential.useHttpPath true
set -euo pipefail

HOST_SOCKET=${1:-}
CONTAINER_SOCKET=${AZURE_DEVOPS_TOKEN_SOCKET:-/mnt/sandbox-auth/azure-devops-token.sock}

# Git appends the operation (get/store/erase) as the final argument. Only `get`
# produces credentials; for store/erase we exit immediately so we don't contact
# the host broker — the in-container credential cache handles persistence.
ACTION=${2:-get}
if [ "$ACTION" != "get" ]; then
  exit 0
fi

protocol=
host=
while IFS='=' read -r key value; do
  case "$key" in
    protocol) protocol=$value ;;
    host) host=$value ;;
  esac
done

[ "$protocol" = "https" ] || exit 0
case "$host" in
  dev.azure.com | *.visualstudio.com) ;;
  *) exit 0 ;;
esac

if [ -n "$HOST_SOCKET" ] && [ -S "$HOST_SOCKET" ]; then
  token_socket=$HOST_SOCKET
else
  token_socket=$CONTAINER_SOCKET
fi
[ -d "$(dirname "$token_socket")" ] || exit 0

token=$(
  python3 - "$token_socket" <<'PY'
import socket, sys, time
socket_path = sys.argv[1]
last_error = None
for _ in range(40):
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.connect(socket_path)
            chunks = []
            while True:
                chunk = client.recv(4096)
                if not chunk:
                    break
                chunks.append(chunk)
            print(b"".join(chunks).decode("utf-8").strip())
            sys.exit(0)
    except OSError as error:
        last_error = error
        time.sleep(0.05)
print(f"ERROR Could not connect to Azure DevOps token broker: {last_error}")
sys.exit(0)
PY
)

if [[ "$token" == ERROR* ]]; then
  echo "$token" >&2
  exit 1
fi

printf 'username=AzureDevOps\n'
printf 'password=%s\n' "$token"
